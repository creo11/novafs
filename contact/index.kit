<!DOCTYPE html>
<html lang="en">
<!-- @import "../_head.kit"-->
<body>
<div class="main-content">
	<!-- @import "../_nav.kit" -->
	<section id="hero" class="contact">
		<div class="center-content">
			<div class="page-title">
				<h1>Contact</h1>
			</div>
		</div>
	</section>
	<section id="aboutPage">
		<div class="center-content margin-50">
			<div class="split-content-container collapse-container">
				<div class="split-content-item">
					<form id="contact-form"action="/api/contact" method="POST">
						<div id="form-group" class="form-group">
							<div>
							<label for="name">Name</label>
							<input id="name" name="name" type="text" required />
							</div>
						
							<div>
							<label for="email">Email</label>
							<input id="email" name="email" type="email" required />
							</div>
						
							<div>
							<label for="phone">Phone</label>
							<input id="phone" name="phone" type="tel" />
							</div>
						
							<div>
							<label for="propertyType">Property Type</label>
							<select id="propertyType" name="propertyType">
								<option value="">Select one</option>
								<option>HOA</option>
								<option>Apartment Building</option>
								<option>Office</option>
								<option>Commercial Property</option>
								<option>School</option>
								<option>Healthcare</option>
								<option>Government</option>
							</select>
							</div>
						
							<div>
							<label for="service">Service Needed</label>
							<select id="service" name="service" required>
								<option value="">Select a service</option>
								<option>Janitorial Services</option>
								<option>Carpet & Area Rug Cleaning</option>
								<option>Garage Cleaning & Pressure Washing</option>
								<option>Garbage Hauling & Paint/Lightbulb Removal</option>
								<option>Graffiti Abatement</option>
								<option>Unit Turnover Services</option>
								<option>Window Cleaning</option>
								<option>Day Porters</option>
							</select>
							</div>
						
							<div>
							<label for="message">Message</label>
							<textarea id="message" name="message" rows="6" required></textarea>
							</div>
							<div class="cf-turnstile" data-sitekey="0x4AAAAAADQoIFINvis_C3xl"></div>
							<button id="contact-submit" type="submit">Request a Quote</button>
						</div>
						<div id="form-message" class="hidden" aria-live="polite">
							<div class="form-message-image">
								<svg xmlns="http://www.w3.org/2000/svg" id="Layer_1" data-name="Layer 1" viewBox="0 0 2902.52 2902.53"><defs><style>.cls-2{fill:#39aa9b}</style></defs><path d="M2716.4 2162.67c118.44-210.22 186.12-452.99 186.12-711.4C2902.52 649.88 2252.65 0 1451.26 0S0 649.88 0 1451.26s649.62 1451.26 1451.26 1451.26c290.97 0 562.2-85.88 789.34-233.55l578.35 138.69c37.43 8.98 70.76-25.64 60.25-62.81l-162.79-582.2ZM797.03 1965.52c-50.51 0-91.27-41.01-91.27-91.26v-845.74c0-50.5 40.76-91.27 91.27-91.27h1154.65c32.3-112.55 136.13-195.09 259.18-195.09 148.69 0 269.18 120.49 269.18 269.18s-120.49 269.43-269.18 269.43c-4.61 0-9.49 0-14.1-.25v593.73c0 50.25-41.01 91.26-91.26 91.26H797.03Z" class="cls-2"/><path d="M2480.04 1011.35c0 148.94-120.49 269.43-269.18 269.43-4.61 0-9.49 0-14.1-.25v593.73c0 50.25-41.01 91.26-91.26 91.26H797.03c-50.51 0-91.27-41.01-91.27-91.26v-845.74c0-50.5 40.76-91.27 91.27-91.27h1154.65c32.3-112.55 136.13-195.09 259.18-195.09 148.69 0 269.18 120.49 269.18 269.18Z" style="fill:#00a7e8"/><path d="M2196.76 1028.52v845.74c0 50.25-41.01 91.26-91.26 91.26H797.03c-50.51 0-91.27-41.01-91.27-91.26v-845.74c0-50.5 40.76-91.27 91.27-91.27H2105.5c43.58 0 80.24 30.76 89.21 71.78 1.28 6.41 2.05 12.82 2.05 19.48Z" style="fill:#f1f2f2"/><path d="m2070.03 1073.17-433.82 378.81 436.57 380.99a33.21 33.21 0 0 1 11.38 25.03c0 18.35-14.87 33.22-33.22 33.22h-6.99c-8.03 0-15.8-2.91-21.85-8.2l-439.87-384.03-44.62 38.74c-24.59 21.55-55.5 32.43-86.41 32.43s-61.82-10.88-86.41-32.43l-44.62-38.74-439.87 384.03a33.23 33.23 0 0 1-21.85 8.2h-7c-18.35 0-33.22-14.87-33.22-33.22 0-9.59 4.15-18.72 11.38-25.03l436.57-380.99-434.95-379.79a34.3 34.3 0 0 1-11.71-24.34c-.74-17.03 11.14-32.03 27.89-35.2l3.09-.58c10.34-1.96 21.01.94 28.94 7.87l531.92 464.48c22.64 19.81 57.03 19.81 79.66 0l529.54-462.41c7.09-6.2 16.47-9.12 25.83-8.07l5.31.6c18.06 2.03 31.23 18.07 29.7 36.19a33.5 33.5 0 0 1-11.37 22.45Z" class="cls-2"/><path d="M2480.04 1011.35c0 148.94-120.49 269.43-269.18 269.43-4.61 0-9.49 0-14.1-.25-91.52-4.88-171.25-55.38-216.11-129.21-12.82-21.02-22.82-44.1-29.74-68.45-6.16-22.81-9.49-46.66-9.49-71.52s3.59-50.51 10.26-74.09c32.3-112.55 136.13-195.09 259.18-195.09 148.69 0 269.18 120.49 269.18 269.18" style="fill:#ed1c24"/><path d="M2138.07 1136.05v-31.67h56.72V930.71h-45.76v-24.25c11.72-2.35 22.03-5.09 30.9-8.22 8.85-3.12 16.94-6.92 24.25-11.34h28.93v217.48h50.48v31.67z" style="fill:#fff"/></svg>
							</div>
							<div class="form-message-content">
								<h1>Thank you! We'll be in touch soon.</h1>
								<p>We've received your request and appreciate the opportunity to work with you. A member of our team will contact you within 24 hours to discuss your property needs and provide the next steps.</p>
							</div>
						</div>
					  </form>
				</div>
				<div class="split-content-item">
					<h1 class="no-margin-bottom">Comprehensive Service Capabilities</h2>
                    <h2>Our team provides a full suite of facility maintenance solutions, including:</h2>
					<ul class="nova-list">
						<li class="stacked">
                            <h3>Core Cleaning</h3>
                            <p>Professional Janitorial Services, Day Porters, and Unit Turnover Services.</p>
                        </li>
						<li class="stacked">
                            <h3>Specialized Maintenance</h3>
                            <p>Carpet & Area Rug Cleaning, Painting, and Lightbulb Replacement.</p>
                        </li>
                        <li class="stacked">
                            <h3>Exterior & Heavy Duty</h3>
                            <p>Pressure Washing, Garage Cleaning, and Garbage Hauling.</p>
                        </li>
                        <li class="stacked">
                            <h3>Facility Protection</h3>
                            <p>Graffiti Abatement and General Maintenance Repairs.</p>
                        </li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	<!-- @import "../_callToAction.kit"-->
</div>
<!-- @import "../_footer.kit" -->
<template id="serviceItem.tpl.html">
	<div class="service-item">
		<div class="service-item-img"
		     style="background-image: url('${img}')">
		</div>
		<div class="service-details">
			<h3 class="service-title">${title}</h3>
			<div class="service-info">${info}</div>
			<!-- <a href="${link}" class="service-link">Learn More</a> -->
		</div>
	</div>
</template>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script src="https://unpkg.com/@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>
<script src="/js/nova-dist.js"></script>
<script src="/js/services-dist.js"></script>
<script>
    const contactForm = document.getElementById("contact-form");
    const formMessage = document.getElementById("form-message");
    const submitButton = document.getElementById("contact-submit");
	const formGroup = document.getElementById("form-group");
  
    contactForm.addEventListener("submit", async function (event) {
      event.preventDefault();
  
      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
  
      try {
        const formData = new FormData(contactForm);
  
        const response = await fetch(contactForm.action, {
          method: "POST",
          body: formData
        });
  
        if (!response.ok) {
          throw new Error("Form submission failed");
        }
  
        formGroup.classList.add("hidden");
		formMessage.classList.remove("hidden");
		window.scrollTo({
			top: document.getElementById("contact-form").offsetTop - 120,
			behavior: "smooth"
		});
  
        contactForm.reset();
  
        if (window.turnstile) {
          turnstile.reset();
        }
      } catch (error) {
		formMessage.classList.remove("hidden");
        formMessage.textContent = "Sorry, something went wrong. Please try again.";
        formMessage.className = "error-message";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Request a Quote";
      }
    });
</script>
</body>
</html>