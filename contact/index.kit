<!DOCTYPE html>
<html lang="en">
<!-- @import "../_head.kit"-->
<body>
<div class="main-content">
	<!-- @import "../_nav.kit" -->
	<section id="hero" class="contact">
		<div class="center-content">
			<div class="page-title">
				<h1>Contact</h1>
			</div>
		</div>
	</section>
	<section id="aboutPage">
		<div class="center-content margin-50">
			<div class="split-content-container collapse-container">
				<div class="split-content-item">
					<form id="contact-form"action="/api/contact" method="POST">
						<div>
						  <label for="name">Name</label>
						  <input id="name" name="name" type="text" required />
						</div>
					  
						<div>
						  <label for="email">Email</label>
						  <input id="email" name="email" type="email" required />
						</div>
					  
						<div>
						  <label for="phone">Phone</label>
						  <input id="phone" name="phone" type="tel" />
						</div>
					  
						<div>
						  <label for="propertyType">Property Type</label>
						  <select id="propertyType" name="propertyType">
							<option value="">Select one</option>
							<option>HOA</option>
							<option>Apartment Building</option>
							<option>Office</option>
							<option>Commercial Property</option>
							<option>School</option>
							<option>Healthcare</option>
							<option>Government</option>
						  </select>
						</div>
					  
						<div>
						  <label for="service">Service Needed</label>
						  <select id="service" name="service" required>
							<option value="">Select a service</option>
							<option>Janitorial Services</option>
							<option>Carpet & Area Rug Cleaning</option>
							<option>Garage Cleaning & Pressure Washing</option>
							<option>Garbage Hauling & Paint/Lightbulb Removal</option>
							<option>Graffiti Abatement</option>
							<option>Unit Turnover Services</option>
							<option>Window Cleaning</option>
							<option>Day Porters</option>
						  </select>
						</div>
					  
						<div>
						  <label for="message">Message</label>
						  <textarea id="message" name="message" rows="6" required></textarea>
						</div>
						<div class="cf-turnstile" data-sitekey="0x4AAAAAADQoIFINvis_C3xl"></div>
						<button id="contact-submit" type="submit">Request a Quote</button>
						<div id="form-message" aria-live="polite"></div>
					  </form>
				</div>
				<div class="split-content-item">
					<h1 class="no-margin-bottom">Comprehensive Service Capabilities</h2>
                    <h2>Our team provides a full suite of facility maintenance solutions, including:</h2>
					<ul class="nova-list">
						<li class="stacked">
                            <h3>Core Cleaning</h3>
                            <p>Professional Janitorial Services, Day Porters, and Unit Turnover Services.</p>
                        </li>
						<li class="stacked">
                            <h3>Specialized Maintenance</h3>
                            <p>Carpet & Area Rug Cleaning, Painting, and Lightbulb Replacement.</p>
                        </li>
                        <li class="stacked">
                            <h3>Exterior & Heavy Duty</h3>
                            <p>Pressure Washing, Garage Cleaning, and Garbage Hauling.</p>
                        </li>
                        <li class="stacked">
                            <h3>Facility Protection</h3>
                            <p>Graffiti Abatement and General Maintenance Repairs.</p>
                        </li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	<!-- @import "../_callToAction.kit"-->
</div>
<!-- @import "../_footer.kit" -->
<template id="serviceItem.tpl.html">
	<div class="service-item">
		<div class="service-item-img"
		     style="background-image: url('${img}')">
		</div>
		<div class="service-details">
			<h3 class="service-title">${title}</h3>
			<div class="service-info">${info}</div>
			<!-- <a href="${link}" class="service-link">Learn More</a> -->
		</div>
	</div>
</template>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script src="https://unpkg.com/@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>
<script src="/js/nova-dist.js"></script>
<script src="/js/services-dist.js"></script>
<script>
    const contactForm = document.getElementById("contact-form");
    const formMessage = document.getElementById("form-message");
    const submitButton = document.getElementById("contact-submit");
  
    contactForm.addEventListener("submit", async function (event) {
      event.preventDefault();
  
      formMessage.textContent = "";
      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
  
      try {
        const formData = new FormData(contactForm);
  
        const response = await fetch(contactForm.action, {
          method: "POST",
          body: formData
        });
  
        if (!response.ok) {
          throw new Error("Form submission failed");
        }
  
        formMessage.textContent = "Thank you! Your message has been sent successfully.";
        formMessage.className = "success-message";
  
        contactForm.reset();
  
        if (window.turnstile) {
          turnstile.reset();
        }
      } catch (error) {
        formMessage.textContent = "Sorry, something went wrong. Please try again.";
        formMessage.className = "error-message";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Request a Quote";
      }
    });
</script>
</body>
</html>